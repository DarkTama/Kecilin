{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kecilin",
  "version": "0.8.1",
  "identifier": "id.co.dak.kecilin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kecilin",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 540,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-direct-composition-video-overlays --disable-accelerated-video-decode"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzODBBQ0Y3RjQxMERFNUQKUldSZDNoRDA5NnlBb3hadTNlb05LTEJhMi9yNDFBQkE5SDFpUEIzeTdLVXJ3UnI3dzgxNFozSkUK",
      "endpoints": [
        "https://github.com/DarkTama/Kecilin/releases/latest/download/latest.json"
      ]
    }
  }
}
